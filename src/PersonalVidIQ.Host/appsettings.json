    "SnapshotRetentionDays": 30,
    "ShortsMaxDurationSeconds": 180,
    "InitialUploadsToTrack": 50,
    "NewVideoWindowHours": 48,
    "NewVideoSnapshotIntervalHours": 3,
    "RecentVideoSnapshotIntervalHours": 24,
    "OldVideoSnapshotIntervalHours": 168,
    "ChannelSnapshotIntervalHours": 24
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=personalvidiq"
  }
}
