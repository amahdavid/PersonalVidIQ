{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "YouTube": {
    "BaseUrl": "https://www.googleapis.com/youtube/v3/",
    "MaxSearchResults": 25,
    "DailyQuotaUnits": 10000,
    "DailySearchCallCap": 50,
    "SearchCacheHours": 24
